  InputLines:
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Placement</span>"}'
    - '// @input float distance = 70 {"label":"Distance (cm)", "hint":"How far in front of the player the panel sits, until they drag it somewhere else.", "widget":"slider", "min":35, "max":200, "step":1}'
    - "// @input float height = -10 {\"label\":\"Height (cm)\", \"hint\":\"How far above (+) or below (-) the player's eyes the panel sits, until they drag it somewhere else.\", \"widget\":\"slider\", \"min\":-60, \"max\":60, \"step\":1}"
