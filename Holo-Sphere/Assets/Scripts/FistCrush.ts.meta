  InputLines:
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Trigger</span>"}'
    - "// @input float grabRadius = 1.8 {\"label\":\"Grab Radius\", \"hint\":\"How close your palm has to be to the sphere for a fist to crush it, as a multiple of the sphere's own radius. 1 means the palm must reach the surface.\", \"widget\":\"slider\", \"min\":0.5, \"max\":5, \"step\":0.1}"
