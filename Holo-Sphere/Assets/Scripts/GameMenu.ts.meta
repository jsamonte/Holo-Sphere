  InputLines:
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Menu</span>"}'
    - '// @input SceneObject menuRoot {"label":"Menu Root", "hint":"Parent object holding the four buttons. Hidden while a run is going."}'
    - '// @input SceneObject tutorialButton {"label":"Tutorial Button"}'
    - '// @input SceneObject easyButton {"label":"Easy Button"}'
    - '// @input SceneObject mediumButton {"label":"Medium Button"}'
    - '// @input SceneObject hardButton {"label":"Hard Button"}'
    - '// @input SceneObject calibrateButton {"label":"Calibrate Button"}'
    - "// @input SceneObject calibrationRoot {\"label\":\"Calibration\", \"hint\":\"The Calibration panel, whose CalibrationMode measures the player's hands and gestures. Left empty, the Calibrate button does nothing.\"}"
    - "// @input SceneObject leaderboardRoot {\"label\":\"Leaderboard\", \"hint\":\"The Leaderboard panel, whose GlobalLeaderboard shows each rhythm mode's top scores after a run - global, or the headset's own when offline. Left empty, runs go straight back to the menu.\"}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Music</span>"}'
    - "// @ui {\"widget\":\"label\", \"label\":\"<span style=\\\"color: #94A3B8; font-size: 11px;\\\">Menu Music loops while the menu is up. Each mode's bed loops until its run ends.</span>\"}"
    - '// @input Asset.AudioTrackAsset menuMusic {"label":"Menu Music", "hint":"Loops for as long as the menu is showing, and stops the moment a mode is chosen."}'
    - '// @input Asset.AudioTrackAsset tutorialMusic {"label":"Tutorial Music"}'
    - '// @input Asset.AudioTrackAsset easyMusic {"label":"Easy Music"}'
    - '// @input Asset.AudioTrackAsset mediumMusic {"label":"Medium Music"}'
    - '// @input Asset.AudioTrackAsset hardMusic {"label":"Hard Music"}'
    - '// @input Asset.AudioTrackAsset calibrationMusic {"label":"Calibration Music", "hint":"Loops while the Calibration panel is up. Left empty, calibration uses the Tutorial Music."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Orders</span>"}'
    - '// @input Asset.AudioTrackAsset duplicateOrder {"label":"Duplicate It"}'
    - '// @input Asset.AudioTrackAsset yoyoOrder {"label":"Yoyo It"}'
    - '// @input Asset.AudioTrackAsset collapseOrder {"label":"Collapse It"}'
    - '// @input Asset.AudioTrackAsset compressOrder {"label":"Compress It"}'
    - '// @input Asset.AudioTrackAsset pokeOrder {"label":"Poke It"}'
    - '// @input Asset.AudioTrackAsset goodJob {"label":"Good Job"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Tutorial Instructions</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Tutorial mode only. Each plays right after its order is called out.</span>"}'
    - '// @input Asset.AudioTrackAsset duplicateInstruction {"label":"Duplicate Instruction", "hint":"Explains how to split the sphere. Assets/Audio/Instruction/Duplicate Instuction.mp3."}'
    - '// @input Asset.AudioTrackAsset yoyoInstruction {"label":"Yoyo Instruction", "hint":"Explains how to flick the sphere out. Assets/Audio/Instruction/Yoyo Instuction.mp3."}'
    - '// @input Asset.AudioTrackAsset collapseInstruction {"label":"Collapse Instruction", "hint":"Explains how to crush the sphere in a fist. Assets/Audio/Instruction/Collapse Instruction.mp3."}'
    - '// @input Asset.AudioTrackAsset compressInstruction {"label":"Compress Instruction", "hint":"Explains how to squish the sphere between two flat hands. Assets/Audio/Instruction/Compress Instructions.mp3."}'
    - '// @input Asset.AudioTrackAsset pokeInstruction {"label":"Poke Instruction", "hint":"Explains how to poke the sphere with an index finger. Assets/Audio/Instruction/Poke Instructions.mp3."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Completion</span>"}'
    - "// @ui {\"widget\":\"label\", \"label\":\"<span style=\\\"color: #94A3B8; font-size: 11px;\\\">The mode's line plays first, then the Ending Sequence. Rhythm modes only get here when their Orders To Win is above 0.</span>\"}"
    - '// @input Asset.AudioTrackAsset tutorialComplete {"label":"Tutorial Complete"}'
    - '// @input Asset.AudioTrackAsset easyComplete {"label":"Easy Complete"}'
    - '// @input Asset.AudioTrackAsset mediumComplete {"label":"Medium Complete"}'
    - '// @input Asset.AudioTrackAsset hardComplete {"label":"Hard Complete"}'
    - '// @input Asset.AudioTrackAsset endingSequence {"label":"Ending Sequence"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Sphere</span>"}'
    - '// @input SceneObject sphere {"label":"Sphere", "hint":"The Holo Sphere, whose TwoHandSplit, YoyoFlick, FistCrush, PalmSquish and FingerPoke are watched to tell when an order has been carried out. Hidden while the menu is up."}'
    - '// @input float compressDepth = 0.5 {"label":"Compress Depth", "hint":"How flat the sphere has to be squished for Compress It to count, from 0 (palms just touching it) to 1 (as flat as PalmSquish goes).", "widget":"slider", "min":0.05, "max":1, "step":0.05}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Timing</span>"}'
    - '// @input float musicVolume = 0.35 {"label":"Music Volume", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float voiceVolume = 1 {"label":"Voice Volume", "widget":"slider", "min":0, "max":2, "step":0.05}'
    - '// @input float duckLevel = 0.4 {"label":"Duck Music To", "hint":"How loud the music gets while a voice line plays, as a fraction of Music Volume, so every order and instruction is heard clearly over the song. 1 never ducks.", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float duckFade = 0.15 {"label":"Duck Fade (s)", "hint":"How long the music takes to dip under a voice line. It takes twice as long to come back up after.", "widget":"slider", "min":0.02, "max":1, "step":0.01}'
    - '// @input float instructionGap = 0.3 {"label":"Gap Before Instruction (s)", "hint":"Tutorial mode: pause between an order finishing and its instruction starting.", "widget":"slider", "min":0, "max":2, "step":0.1}'
    - '// @input float repeatInstructionsAfter = 15 {"label":"Repeat Instructions After (s)", "hint":"Tutorial mode: if an order still is not done this many seconds after its instructions finish playing, they play again - and again after each repeat - until it is. 0 never repeats them.", "widget":"slider", "min":0, "max":60, "step":1}'
    - '// @input float praiseGap = 1.2 {"label":"Gap After Praise (s)", "hint":"Tutorial mode: pause between Good Job finishing and the next order being called out.", "widget":"slider", "min":0, "max":3, "step":0.1}'
    - '// @input float endingGap = 0.6 {"label":"Gap Before Ending (s)", "hint":"Pause between the completion line finishing and the Ending Sequence starting.", "widget":"slider", "min":0, "max":3, "step":0.1}'
    - "// @input float finishGap = 2.5 {\"label\":\"Gap Before Menu (s)\", \"hint\":\"Pause between the Ending Sequence finishing and the menu, or a rhythm mode's leaderboard, coming up.\", \"widget\":\"slider\", \"min\":0, \"max\":5, \"step\":0.1}"
    - '// @input float failGap = 1 {"label":"Gap Before Ending On Fail (s)", "hint":"Rhythm modes: pause between a failed order and the Ending Sequence starting. The leaderboard follows the Ending Sequence.", "widget":"slider", "min":0, "max":5, "step":0.1}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Rhythm (Easy)</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Measured from the Easy song: 123 BPM, first downbeat at 0.148 s. After the 4 s silent intro the first order lands on the downbeat at 4.05 s.</span>"}'
    - '// @input float bpm = 123 {"label":"BPM", "hint":"Tempo of the Easy song. Measured at 123.0 and steady for the whole track."}'
    - '// @input float firstDownbeat = 0.148 {"label":"First Downbeat (s)", "hint":"Seconds into the song file where bar 1 lands. Every order is placed on a bar line counted from here."}'
    - '// @input float beatsPerBar = 4 {"label":"Beats Per Bar", "widget":"slider", "min":2, "max":8, "step":1}'
    - '// @input float barsPerOrder = 2 {"label":"Bars Per Order", "hint":"An order is called on the first beat of every this-many bars, and must be done before the next one. 2 bars at 123 BPM is 3.9 s per order; 1 bar is 1.95 s.", "widget":"slider", "min":1, "max":8, "step":1}'
    - '// @input float startDelay = 4 {"label":"Silent Intro (s)", "hint":"No orders until this many seconds into the song. The first order is the first bar line after it.", "widget":"slider", "min":0, "max":30, "step":0.5}'
    - '// @input float orderCount {"label":"Orders To Win", "hint":"Correct orders in a row that win the run. 0 never ends it: the run goes on until an order is missed."}'
    - '// @input float beatOffset {"label":"Beat Offset (s)", "hint":"Nudges every order later (positive) or earlier (negative) against the music, if they sound slightly off the beat on device.", "widget":"slider", "min":-0.25, "max":0.25, "step":0.005}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Rhythm (Medium)</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Measured from the Medium song, Fridays: 136 BPM, first downbeat at 1.060 s. After the 4 s silent intro the first order lands on the downbeat at 4.59 s.</span>"}'
    - '// @input float mediumBpm = 136 {"label":"BPM", "hint":"Tempo of the Medium song, Fridays. Measured at 136.0 and steady for the whole track."}'
    - '// @input float mediumFirstDownbeat = 1.06 {"label":"First Downbeat (s)", "hint":"Seconds into the song file where bar 1 lands. Every order is placed on a bar line counted from here."}'
    - '// @input float mediumBeatsPerBar = 4 {"label":"Beats Per Bar", "widget":"slider", "min":2, "max":8, "step":1}'
    - '// @input float mediumBarsPerOrder = 2 {"label":"Bars Per Order", "hint":"An order is called on the first beat of every this-many bars, and must be done before the next one. 2 bars at 136 BPM is 3.5 s per order; 1 bar is 1.76 s.", "widget":"slider", "min":1, "max":8, "step":1}'
    - '// @input float mediumStartDelay = 4 {"label":"Silent Intro (s)", "hint":"No orders until this many seconds into the song. The first order is the first bar line after it.", "widget":"slider", "min":0, "max":30, "step":0.5}'
    - '// @input float mediumOrderCount {"label":"Orders To Win", "hint":"Correct orders in a row that win the run. 0 never ends it: the run goes on until an order is missed."}'
    - '// @input float mediumBeatOffset {"label":"Beat Offset (s)", "hint":"Nudges every order later (positive) or earlier (negative) against the music, if they sound slightly off the beat on device.", "widget":"slider", "min":-0.25, "max":0.25, "step":0.005}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Rhythm (Hard)</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Measured from the Hard song, The Cutback: 147 BPM, first downbeat at 0.230 s. The grid starts on that downbeat, so after the 4 s silent intro the first order lands on beat 1 at 5.13 s. The drop is at 13.29 s.</span>"}'
    - '// @input float hardBpm = 147 {"label":"BPM", "hint":"Tempo of the Hard song, The Cutback. Measured at 147.0 and steady for the whole track."}'
    - "// @input float hardFirstDownbeat = 0.23 {\"label\":\"First Downbeat (s)\", \"hint\":\"Seconds into the song file of the downbeat the order grid is counted from, in beats. Any downbeat works; 0.230 s is the song's first, which puts the first order after the silent intro on beat 1. With 6 beats between orders the grid alternates beats 1 and 3, so a grid a bar later would put it on beat 3 instead.\"}"
    - '// @input float hardBeatsPerBar = 4 {"label":"Beats Per Bar", "widget":"slider", "min":2, "max":8, "step":1}'
    - "// @input float hardBarsPerOrder = 1.5 {\"label\":\"Bars Per Order\", \"hint\":\"An order is called every this-many bars, rounded to the nearest beat, and must be done before the next one. 1.5 bars at 147 BPM is 6 beats, 2.4 s per order, alternating the first and third beat of the bar and clearly faster than Medium's 3.5 s. 2 bars would be 3.3 s, every order on beat 1.\", \"widget\":\"slider\", \"min\":1, \"max\":8, \"step\":0.25}"
    - '// @input float hardStartDelay = 4 {"label":"Silent Intro (s)", "hint":"No orders until this many seconds into the song. The first order is the first bar line after it.", "widget":"slider", "min":0, "max":30, "step":0.5}'
    - '// @input float hardOrderCount {"label":"Orders To Win", "hint":"Correct orders in a row that win the run. 0 never ends it: the run goes on until an order is missed."}'
    - '// @input float hardBeatOffset {"label":"Beat Offset (s)", "hint":"Nudges every order later (positive) or earlier (negative) against the music, if they sound slightly off the beat on device.", "widget":"slider", "min":-0.25, "max":0.25, "step":0.005}'
