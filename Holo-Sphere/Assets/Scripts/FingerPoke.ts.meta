    - "// @input float depth = 0.15 {\"label\":\"Depth\", \"hint\":\"How far past the sphere's surface the fingertip has to reach to count, as a fraction of the sphere's radius. 0 counts at the surface; higher needs a deeper poke.\", \"widget\":\"slider\", \"min\":0, \"max\":0.8, \"step\":0.05}"
