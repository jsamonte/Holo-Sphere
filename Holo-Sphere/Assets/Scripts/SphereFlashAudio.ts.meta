  InputLines:
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Tracks</span>"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #94A3B8; font-size: 11px;\">Audio files played on each strobe flash</span>"}'
    - '// @input Asset.AudioTrackAsset mainTrack {"label":"Main Track", "hint":"Sound played from the original sphere on every flash. Assets/Audio/sphere-1.mp3."}'
    - '// @input Asset.AudioTrackAsset duplicateTrack {"label":"Duplicate Track", "hint":"Sound played from the second sphere once TwoHandSplit has split it. Assets/Audio/sphere-2.mp3. Leave empty to keep the copy silent."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Mix</span>"}'
    - "// @input float mainVolume = 1 {\"label\":\"Main Volume\", \"hint\":\"Volume multiplier for the original sphere's flashes.\", \"widget\":\"slider\", \"min\":0, \"max\":2, \"step\":0.05}"
    - "// @input float duplicateVolume = 0.9 {\"label\":\"Duplicate Volume\", \"hint\":\"Volume multiplier for the copy's flashes, relative to its own track.\", \"widget\":\"slider\", \"min\":0, \"max\":2, \"step\":0.05}"
    - '// @input bool spatialize = true {"label":"Spatialize", "hint":"Position the sound in 3D at the sphere it belongs to. Turn off for a flat, non-directional mix that ignores where the spheres are."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Triggering</span>"}'
    - '// @input float voiceCount = 4 {"label":"Voices Per Sphere", "hint":"How many overlapping sounds each sphere can hold. Raise if a fast strobe sounds clipped, lower to save memory.", "widget":"slider", "min":1, "max":8, "step":1}'
    - '// @input float minInterval {"label":"Min Interval (s)", "hint":"Shortest gap between sounds. 0 plays on every flash. Raise it to thin out a fast strobe so the audio does not machine gun.", "widget":"slider", "min":0, "max":0.5, "step":0.01}'
